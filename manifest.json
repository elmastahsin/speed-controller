{
  "manifest_version": 3,
  "name": "Speed Controller",
  "version": "0.1.0",
  "description": "Video ve audio oynatma hızını klavye kısayolları, video üstü gösterge ve popup ile kontrol edin. Sadece açtığınız sekmede çalışır.",
  "permissions": ["activeTab", "scripting", "storage"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Speed Controller",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
